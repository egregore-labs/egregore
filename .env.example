# Egregore — Personal Secrets
# Copy this to .env and fill in your values.
# .env is gitignored — never commit it.

# Your GitHub token (created automatically during onboarding)
GITHUB_TOKEN=

# Your org's Egregore API key (provided during setup)
EGREGORE_API_KEY=

# Uncomment to disable telemetry (anonymous usage stats)
# EGREGORE_NO_TELEMETRY=1
