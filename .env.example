# Egregore — Environment Variables
# Copy this to .env and fill in your values.
# .env is gitignored — never commit it.

# --- Required ---

# GitHub personal access token (created by bin/github-auth.sh device flow)
# Scopes: repo, read:org
GITHUB_TOKEN=

# --- Connected mode only ---

# Egregore API key (auto-provisioned on first session if API is configured)
# Format: ek_<slug>_<secret>
# Not needed in local mode.
# EGREGORE_API_KEY=

# --- Connectors ---

# Notion internal-integration token (your own workspace's private connection).
# Set via the hidden prompt — bash bin/connector-notion.sh auth set — rather
# than editing this file by hand. Same variable the official `ntn` CLI reads.
# NOTION_API_TOKEN=

# --- Optional overrides ---

# Override API URL from egregore.json (useful for local API development)
# EGREGORE_API_URL=

# --- Egregore API server: Stripe Connected billing ---
#
# Server-side only. Use sandbox values for local development and live values
# only in the production secret store. Never commit populated values.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_PRICE_ID=
# EGREGORE_WEB_URL=https://egregore.xyz

# Force the npm-published egregore-artifacts renderer in /handoff and /view,
# even when a local install is present under packages/egregore-artifacts/.
# Per-shell override of `prefer_published_artifacts` in egregore.json — set to
# 0 to force the local install when an instance otherwise prefers published.
# EGREGORE_USE_PUBLISHED=1

# --- Telemetry ---

# Opt out of anonymous telemetry (command names, timestamps, durations only —
# never file contents, code, env var values, or conversation content)
# EGREGORE_NO_TELEMETRY=1

# Standard opt-out (respected by many tools)
# DO_NOT_TRACK=1

# Debug telemetry: print events to stderr instead of buffering
# EGREGORE_TELEMETRY_DEBUG=1
